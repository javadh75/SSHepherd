  - {name: bob, keys: ["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMqTrBcFGHBx1nuDx/8O/oEI6OxFMFdddyaHkzPb2r58"]}
  - {name: carol, keys: ["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIG56HN0psLeP0Tr0xVmP7/TvKpcWbjym8uT7/M2AUFvx"]}
servers:
  - {name: web-1, host: 10.0.0.1, user: deploy, tags: [web]} # front
  - {name: web-2, host: 10.0.0.2, user: deploy, tags: [web]}
  - {name: db-1, host: 10.0.0.9, user: deploy, tags: [db]}
  - {name: db-2, host: 10.0.0.8, user: deploy, tags: [db]}
access:
