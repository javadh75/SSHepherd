p="${HOME:?}"/'.ssh/authorized_keys'; set -f; u=$(id -u); d=$(dirname "$p"); b="$p".sshepherd.bak; h=${HOME%/}; ph=$(cd -P "$h" 2>/dev/null && pwd -P && echo .); ph=${ph%??}; q="$d"; while :; do set -- $(ls -ldn "$q"); case $1 in l*) ;; ?????w*|????????w*) exit 48;; esac; if [ "$3" != "$u" ] && [ "$3" != 0 ]; then exit 48; fi; if [ "$q" = "$h" ] || [ "$q" = / ] || [ "$q" = . ]; then break; fi; q=$(dirname "$q" && echo .); q=${q%??}; done; q=$(cd -P "$d" && pwd -P && echo .) || exit 1; q=${q%??}; while :; do set -- $(ls -ldn "$q"); case $1 in ?????w*|????????w*) exit 48;; esac; if [ "$3" != "$u" ] && [ "$3" != 0 ]; then exit 48; fi; if [ "$q" = "$ph" ] || [ "$q" = / ]; then break; fi; q=$(dirname "$q" && echo .); q=${q%??}; done; l="$p".sshepherd.lock; mkdir "$l" 2>/dev/null || { [ -d "$l" ] && { echo "sshepherd-lock $(date +%s)"; head -n 1 "$l/owner" 2>/dev/null | cut -c1-200; exit 47; }; if mkdir "$l"; then rmdir "$l"; exit 47; fi; exit 1; }; trap 'x=$?; rm -f "$p".sshepherd.tmp "$p".sshepherd.cas "$l/owner"; rmdir "$l" 2>/dev/null' EXIT; trap 'exit 1' HUP INT TERM PIPE; printf 'v1 %s %s %s\n' 'OWNER-IDENT' "$$" "$(date +%s)" > "$l/owner" 2>/dev/null || :; if [ -L "$p" ]; then exit 45; fi; if [ ! -f "$p" ]; then exit 46; fi; command -v cksum >/dev/null 2>&1 || { echo "sshepherd: cksum not found on the server" >&2; exit 1; }; set -- $(cksum < "$p"); if [ "$1" != 4242 ] || [ "$2" != 7 ]; then exit 46; fi; if [ -L "$b" ]; then exit 45; fi; mv -f "$b" "$p"
