p="${HOME:?}"/'.ssh/authorized_keys2'; set -f; u=$(id -u); d=$(dirname "$p" && echo .); d=${d%??}; s="$p".sshepherd.disabled; h=${HOME%/}; ph=$(cd -P "$h" 2>/dev/null && pwd -P && echo .); ph=${ph%??}; q="$d"; while :; do set -- $(ls -ldn "$q"); case $1 in l*) ;; ?????w*|????????w*) exit 48;; esac; if [ "$3" != "$u" ] && [ "$3" != 0 ]; then exit 48; fi; if [ "$q" = "$h" ] || [ "$q" = / ] || [ "$q" = . ]; then break; fi; q=$(dirname "$q" && echo .); q=${q%??}; done; q=$(cd -P "$d" && pwd -P && echo .) || exit 1; q=${q%??}; while :; do set -- $(ls -ldn "$q"); case $1 in ?????w*|????????w*) exit 48;; esac; if [ "$3" != "$u" ] && [ "$3" != 0 ]; then exit 48; fi; if [ "$q" = "$ph" ] || [ "$q" = / ]; then break; fi; q=$(dirname "$q" && echo .); q=${q%??}; done; if [ -e "$p" ] || [ -L "$p" ]; then if [ -e "$s" ] || [ -L "$s" ]; then s="$s.$(date -u +%Y%m%dT%H%M%SZ)"; if [ -e "$s" ] || [ -L "$s" ]; then s="$s.$$"; fi; if [ -e "$s" ] || [ -L "$s" ]; then exit 1; fi; fi; mv -f "$p" "$s" || exit 1; echo "sshepherd-keys2 ${s##*/}"; fi
