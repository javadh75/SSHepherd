p="${HOME:?}"/'.ssh/authorized_keys'; set -f; umask 077; u=$(id -u); d=$(dirname "$p"); b="$p".sshepherd.bak; o="$p".sshepherd.orig; t="$p".sshepherd.tmp; c="$p".sshepherd.cas; if [ -L "$p" ]; then exit 45; fi; if [ -L "$d" ]; then exit 48; fi; m=; e="$d"; while [ ! -e "$e" ] && [ ! -L "$e" ]; do m="$e"; e=$(dirname "$e"); done; D="$d"; d="$e"; h=${HOME%/}; ph=$(cd -P "$h" 2>/dev/null && pwd -P && echo .); ph=${ph%??}; q="$d"; while :; do set -- $(ls -ldn "$q"); case $1 in l*) ;; ?????w*|????????w*) exit 48;; esac; if [ "$3" != "$u" ] && [ "$3" != 0 ]; then exit 48; fi; if [ "$q" = "$h" ] || [ "$q" = / ] || [ "$q" = . ]; then break; fi; q=$(dirname "$q" && echo .); q=${q%??}; done; q=$(cd -P "$d" && pwd -P && echo .) || exit 1; q=${q%??}; while :; do set -- $(ls -ldn "$q"); case $1 in ?????w*|????????w*) exit 48;; esac; if [ "$3" != "$u" ] && [ "$3" != 0 ]; then exit 48; fi; if [ "$q" = "$ph" ] || [ "$q" = / ]; then break; fi; q=$(dirname "$q" && echo .); q=${q%??}; done; d="$D"; C=; U() { for k in $C; do j=0; q="$d"; while [ $j -lt $k ]; do q=$(dirname "$q"); j=$((j+1)); done; rmdir "$q" 2>/dev/null; done; }; trap '[ $? = 0 ] || U' EXIT; trap 'exit 1' HUP INT TERM PIPE; if [ -n "$m" ]; then k=0; q="$d"; while [ "$q" != "$m" ] && [ "$q" != / ] && [ "$q" != . ]; do k=$((k+1)); q=$(dirname "$q"); done; while [ $k -ge 0 ]; do j=0; q="$d"; while [ $j -lt $k ]; do q=$(dirname "$q"); j=$((j+1)); done; if [ ! -e "$q" ] && [ ! -L "$q" ]; then mkdir "$q" || exit 1; C="$k $C"; fi; k=$((k-1)); done; fi; ( set -- $(ls -ldn "$d"); if [ "$3" != "$u" ]; then exit 48; fi; h=${HOME%/}; ph=$(cd -P "$h" 2>/dev/null && pwd -P && echo .); ph=${ph%??}; q="$d"; while :; do set -- $(ls -ldn "$q"); case $1 in l*) ;; ?????w*|????????w*) exit 48;; esac; if [ "$3" != "$u" ] && [ "$3" != 0 ]; then exit 48; fi; if [ "$q" = "$h" ] || [ "$q" = / ] || [ "$q" = . ]; then break; fi; q=$(dirname "$q" && echo .); q=${q%??}; done; q=$(cd -P "$d" && pwd -P && echo .) || exit 1; q=${q%??}; while :; do set -- $(ls -ldn "$q"); case $1 in ?????w*|????????w*) exit 48;; esac; if [ "$3" != "$u" ] && [ "$3" != 0 ]; then exit 48; fi; if [ "$q" = "$ph" ] || [ "$q" = / ]; then break; fi; q=$(dirname "$q" && echo .); q=${q%??}; done ) || exit $?; l="$p".sshepherd.lock; mkdir "$l" 2>/dev/null || { [ -d "$l" ] && { echo "sshepherd-lock $(date +%s)"; head -n 1 "$l/owner" 2>/dev/null | cut -c1-200; exit 47; }; if mkdir "$l"; then rmdir "$l"; exit 47; fi; exit 1; }; trap 'x=$?; rm -f "$p".sshepherd.tmp "$p".sshepherd.cas "$l/owner"; rmdir "$l" 2>/dev/null; [ "$x" = 0 ] || U' EXIT; trap 'exit 1' HUP INT TERM PIPE; printf 'v1 %s %s %s\n' 'OWNER-IDENT' "$$" "$(date +%s)" > "$l/owner" 2>/dev/null || :; if [ -L "$p" ]; then exit 45; fi; if [ -e "$p" ]; then set -- $(ls -ldn "$p"); if [ "$3" != "$u" ]; then exit 48; fi; fi; command -v cksum >/dev/null 2>&1 || { echo "sshepherd: cksum not found on the server" >&2; exit 1; }; rm -f "$t"; (set -C; cat > "$t") || { rm -f "$t"; exit 1; }; set -- $(wc -c < "$t"); if [ "$1" != 12 ]; then rm -f "$t"; exit 49; fi; dd if=/dev/null of="$t" conv=notrunc,fsync 2>/dev/null || :; if [ -L "$p" ]; then exit 45; fi; if [ ! -f "$p" ]; then exit 46; fi; rm -f "$c" || exit 1; (set -C; cat "$p" > "$c") || exit 1; set -- $(cksum < "$c"); if [ "$1" != 4242 ] || [ "$2" != 7 ]; then rm -f "$c"; exit 46; fi; rm -f "$b" || exit 1; mv -f "$c" "$b" || exit 1; if [ -e "$b" ]; then dd if=/dev/null of="$b" conv=notrunc,fsync 2>/dev/null || :; fi; mv -f "$t" "$p" || { rm -f "$t"; exit 1; }
